# J.A.R.V.I.S. v2.0.0 Environment Configuration
# Copy this file to .env and add your own OpenRouter API key.
# NEVER commit .env to version control — it is in .gitignore.

# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Default model (Claude Sonnet 4 = top reasoning, change as needed)
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Optional: host your own update manifest for daily self-update
# JARVIS_UPDATE_MANIFEST=https://your-domain.com/version.json
