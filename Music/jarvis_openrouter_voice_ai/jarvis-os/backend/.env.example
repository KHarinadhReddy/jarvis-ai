# J.A.R.V.I.S. backend configuration.
# Copy this file to .env and fill in a real key. Never commit .env.

# Preferred: DeepSeek official API (deepseek-flash supports text, vision, tools).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional fallback: OpenRouter (used only when DEEPSEEK_API_KEY is empty).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Local device pairing token. Change this before exposing the backend.
DEVICE_TOKEN=jarvis-dev-token

# Comma-separated browser origins. Leave empty for Android-only use.
ALLOWED_ORIGINS=

# TTS voices (Edge neural voices; Telugu and Indian English).
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_TE=te-IN-ShrutiNeural
TTS_RATE_LIMIT_PER_MINUTE=30

# Set to 1 only for automated tests; never in production.
ALLOW_MOCK=0
